# Copy to .env.local and fill values.

# Public API base — used by client-side fetch. Point to gateway.
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# Default tenant subdomain (dev convenience — in prod, resolved from window.location host)
NEXT_PUBLIC_DEFAULT_TENANT_SUBDOMAIN=acme

# Set true to run the UI with mock data (no backend needed) — enabled by default in Vercel preview.
NEXT_PUBLIC_MOCK_MODE=true
