{
  "$description": "Dark theme overrides — only override where the palette meaning changes; unchanged tokens inherit from light.json.",
  "background": {
    "canvas":     { "$value": "{color.gray.950}", "$type": "color" },
    "surface":    { "$value": "{color.gray.900}", "$type": "color" },
    "raised":     { "$value": "{color.gray.800}", "$type": "color" },
    "sunken":     { "$value": "{color.gray.900}", "$type": "color" },
    "overlay":    { "$value": "#000000B3",        "$type": "color" },
    "brand-subtle":{"$value": "{brand.accent.900}","$type": "color" }
  },
  "text": {
    "primary":   { "$value": "{color.gray.50}",  "$type": "color" },
    "secondary": { "$value": "{color.gray.300}", "$type": "color" },
    "tertiary":  { "$value": "{color.gray.400}", "$type": "color" },
    "disabled":  { "$value": "{color.gray.600}", "$type": "color" },
    "inverse":   { "$value": "{color.gray.900}", "$type": "color" },
    "brand":     { "$value": "{brand.accent.300}", "$type": "color" },
    "link":      { "$value": "{brand.accent.300}", "$type": "color" }
  },
  "border": {
    "subtle":    { "$value": "{color.gray.800}", "$type": "color" },
    "default":   { "$value": "{color.gray.700}", "$type": "color" },
    "strong":    { "$value": "{color.gray.600}", "$type": "color" }
  }
}
