<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

  <changeSet id="002-users" author="hirevo">
    <createTable tableName="users" schemaName="iam">
      <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="tenant_id" type="uuid"><constraints nullable="false"/></column>
      <column name="email" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="password_hash" type="varchar(255)"/>
      <column name="full_name" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="phone" type="varchar(20)"/>
      <column name="avatar_url" type="text"/>
      <column name="status" type="varchar(20)" defaultValue="invited"><constraints nullable="false"/></column>
      <column name="two_fa_enabled" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="two_fa_secret" type="varchar(255)"/>
      <column name="last_login_at" type="timestamptz"/>
      <column name="failed_logins" type="int" defaultValueNumeric="0"><constraints nullable="false"/></column>
      <column name="locked_until" type="timestamptz"/>
      <column name="created_at" type="timestamptz" defaultValueComputed="now()"><constraints nullable="false"/></column>
      <column name="updated_at" type="timestamptz" defaultValueComputed="now()"><constraints nullable="false"/></column>
      <column name="deleted_at" type="timestamptz"/>
    </createTable>

    <addUniqueConstraint schemaName="iam" tableName="users"
        columnNames="tenant_id, email" constraintName="uk_users_tenant_email"/>
    <sql>ALTER TABLE iam.users ADD CONSTRAINT users_status_check
         CHECK (status IN ('active','inactive','invited','locked'));</sql>
    <sql>CREATE INDEX idx_users_tenant ON iam.users(tenant_id) WHERE deleted_at IS NULL;</sql>
  </changeSet>

  <changeSet id="002-roles" author="hirevo">
    <createTable tableName="roles" schemaName="iam">
      <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="tenant_id" type="uuid"/>
      <column name="name" type="varchar(50)"><constraints nullable="false"/></column>
      <column name="description" type="text"/>
      <column name="is_system" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="created_at" type="timestamptz" defaultValueComputed="now()"><constraints nullable="false"/></column>
    </createTable>
    <sql>CREATE UNIQUE INDEX uk_roles_tenant_name ON iam.roles(COALESCE(tenant_id,'00000000-0000-0000-0000-000000000000'), name);</sql>
  </changeSet>

  <changeSet id="002-permissions" author="hirevo">
    <createTable tableName="permissions" schemaName="iam">
      <column name="id" type="serial"><constraints primaryKey="true" nullable="false"/></column>
      <column name="code" type="varchar(100)"><constraints nullable="false" unique="true"/></column>
      <column name="module" type="varchar(50)"><constraints nullable="false"/></column>
      <column name="description" type="text"/>
    </createTable>
  </changeSet>

  <changeSet id="002-role-permissions" author="hirevo">
    <createTable tableName="role_permissions" schemaName="iam">
      <column name="role_id" type="uuid"><constraints nullable="false"/></column>
      <column name="permission_id" type="int"><constraints nullable="false"/></column>
    </createTable>
    <addPrimaryKey schemaName="iam" tableName="role_permissions"
        columnNames="role_id, permission_id" constraintName="pk_role_permissions"/>
    <addForeignKeyConstraint baseTableSchemaName="iam" baseTableName="role_permissions"
        baseColumnNames="role_id"
        referencedTableSchemaName="iam" referencedTableName="roles"
        referencedColumnNames="id" onDelete="CASCADE"
        constraintName="fk_role_perms_role"/>
    <addForeignKeyConstraint baseTableSchemaName="iam" baseTableName="role_permissions"
        baseColumnNames="permission_id"
        referencedTableSchemaName="iam" referencedTableName="permissions"
        referencedColumnNames="id" onDelete="CASCADE"
        constraintName="fk_role_perms_perm"/>
  </changeSet>

  <changeSet id="002-user-roles" author="hirevo">
    <!--
      scope_branch_id is NOT NULL with a zero-UUID sentinel for "no branch scope"
      instead of a nullable column, because PostgreSQL does not allow expressions
      (e.g. COALESCE) inside a PRIMARY KEY constraint — only plain column lists.
      A sentinel default keeps the composite PK a straightforward column list
      while still letting "global" role assignments (no branch restriction) work.
    -->
    <createTable tableName="user_roles" schemaName="iam">
      <column name="user_id" type="uuid"><constraints nullable="false"/></column>
      <column name="role_id" type="uuid"><constraints nullable="false"/></column>
      <column name="scope_branch_id" type="uuid" defaultValueComputed="'00000000-0000-0000-0000-000000000000'::uuid">
        <constraints nullable="false"/>
      </column>
      <column name="assigned_at" type="timestamptz" defaultValueComputed="now()"><constraints nullable="false"/></column>
    </createTable>
    <addPrimaryKey schemaName="iam" tableName="user_roles"
        columnNames="user_id, role_id, scope_branch_id" constraintName="pk_user_roles"/>
    <addForeignKeyConstraint baseTableSchemaName="iam" baseTableName="user_roles"
        baseColumnNames="user_id"
        referencedTableSchemaName="iam" referencedTableName="users"
        referencedColumnNames="id" onDelete="CASCADE"
        constraintName="fk_user_roles_user"/>
    <addForeignKeyConstraint baseTableSchemaName="iam" baseTableName="user_roles"
        baseColumnNames="role_id"
        referencedTableSchemaName="iam" referencedTableName="roles"
        referencedColumnNames="id" onDelete="CASCADE"
        constraintName="fk_user_roles_role"/>
  </changeSet>

</databaseChangeLog>
