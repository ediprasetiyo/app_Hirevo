<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

  <changeSet id="003-user-mfa-methods" author="hirevo">
    <createTable tableName="user_mfa_methods" schemaName="iam">
      <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
        <constraints primaryKey="true"/>
      </column>
      <column name="tenant_id" type="uuid"><constraints nullable="false"/></column>
      <column name="user_id" type="uuid"><constraints nullable="false"/></column>
      <column name="method_type" type="varchar(20)"><constraints nullable="false"/></column>
      <column name="display_name" type="varchar(100)"/>
      <column name="totp_secret_encrypted" type="bytea"/>
      <column name="webauthn_credential_id" type="bytea"/>
      <column name="webauthn_public_key" type="bytea"/>
      <column name="webauthn_sign_count" type="bigint" defaultValueNumeric="0"/>
      <column name="webauthn_aaguid" type="uuid"/>
      <column name="phone_number" type="varchar(20)"/>
      <column name="is_primary" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="is_verified" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="last_used_at" type="timestamptz"/>
      <column name="created_at" type="timestamptz" defaultValueComputed="now()"><constraints nullable="false"/></column>
      <column name="revoked_at" type="timestamptz"/>
    </createTable>
    <sql>ALTER TABLE iam.user_mfa_methods ADD CONSTRAINT mfa_method_type_check
         CHECK (method_type IN ('totp','webauthn','sms','email'));</sql>
    <sql>CREATE INDEX idx_mfa_user_active ON iam.user_mfa_methods(user_id) WHERE revoked_at IS NULL;</sql>
    <addForeignKeyConstraint baseTableSchemaName="iam" baseTableName="user_mfa_methods"
        baseColumnNames="user_id"
        referencedTableSchemaName="iam" referencedTableName="users"
        referencedColumnNames="id" onDelete="CASCADE"
        constraintName="fk_mfa_user"/>
  </changeSet>

  <changeSet id="003-mfa-recovery-codes" author="hirevo">
    <createTable tableName="mfa_recovery_codes" schemaName="iam">
      <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
        <constraints primaryKey="true"/>
      </column>
      <column name="user_id" type="uuid"><constraints nullable="false"/></column>
      <column name="code_hash" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="used_at" type="timestamptz"/>
      <column name="created_at" type="timestamptz" defaultValueComputed="now()"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableSchemaName="iam" baseTableName="mfa_recovery_codes"
        baseColumnNames="user_id"
        referencedTableSchemaName="iam" referencedTableName="users"
        referencedColumnNames="id" onDelete="CASCADE"
        constraintName="fk_recovery_user"/>
  </changeSet>

</databaseChangeLog>
